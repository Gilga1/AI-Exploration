# Copy to backend/.env and fill in values. Nothing in the app is hardcoded.

# --- Required: Postgres ---------------------------------------------------
APP_DATABASE_URL=postgresql://agentic_rag:change-me@localhost:5432/agentic_rag_eval

# --- Required: OpenRouter (OpenAI-compatible) -----------------------------
OPENROUTER_API_KEY=sk-or-your-key-here
APP_LLM_MODEL=openai/gpt-4o-mini
APP_LLM_BASE_URL=https://openrouter.ai/api/v1
APP_LLM_PROVIDER=openrouter

# --- Auth (recommended outside localhost) --------------------------------
# When unset in production-like environments, the API refuses to start unless
# APP_AUTH_DISABLED=true is explicitly set for local development.
APP_API_KEY=
APP_AUTH_DISABLED=true

# --- Frontend CORS -------------------------------------------------------
APP_CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Telemetry -----------------------------------------------------------
# Optional OTLP export; spans are always persisted to Postgres as well.
# APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
APP_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Evaluation ----------------------------------------------------------
APP_EVAL_SAMPLING_RATE=1.0
APP_METRICS_SCORE_BACKSTOP=false
APP_METRICS_PER_TRACE_LIMIT=500

# --- Alerting (optional) -------------------------------------------------
# APP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
APP_ALERT_WEBHOOK_URL=
APP_ALERT_WINDOW_HOURS=24
APP_ALERT_COOLDOWN_MINUTES=30
# APP_ALERT_THRESHOLDS={"Faithfulness": 0.8}
APP_ALERT_THRESHOLDS=

# --- Agent limits --------------------------------------------------------
APP_AGENT_QUESTION_MAX_LENGTH=4096
APP_AGENT_MIN_ITERATIONS=2

# --- RAG tuning (optional) -----------------------------------------------
APP_RAG_EMBEDDING_MODEL=
APP_RAG_EMBEDDING_DIMENSION=256
APP_RAG_RETRIEVAL_K=3

# --- Runtime -------------------------------------------------------------
APP_ENVIRONMENT=development
APP_DOCS_ENABLED=true
