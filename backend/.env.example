# Required for the fully LLM-driven harness (no offline stub exists).
# Generation AND judging both use this key.
APP_OPENAI_API_KEY=sk-your-openai-api-key-here

# Chat model used for generation and DeepEval judges.
APP_LLM_MODEL=gpt-4o-mini

# --- Database -----------------------------------------------------------
# Leave unset to use a local SQLite store (./traces.db, WAL mode).
# For the docker-compose Postgres:
# APP_DATABASE_URL=postgresql://agentic_rag:agentic_rag_dev@localhost:5432/agentic_rag_eval
APP_DATABASE_URL=

# --- Telemetry ----------------------------------------------------------
# Point at the OTel Collector to export spans off-process (infra/docker-compose.yml).
# Leave unset to persist completed spans locally in the database instead.
# APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
APP_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Auth (recommended for anything beyond localhost) -------------------
# When set, ALL /metrics/*, /eval/* and /agent/* routes require X-API-Key.
# Unset = open access (dev default).
APP_API_KEY=

# --- Evaluation cost control --------------------------------------------
# Head-based sampling rate for trace SCORING. 1.0 = judge everything (dev);
# 0.1-0.2 is typical for prod. Deterministic per trace id.
APP_EVAL_SAMPLING_RATE=1.0

# Optional backstop: score pending traces synchronously inside GET /metrics.
# Off by default because it can make dashboard reads slow/expensive.
APP_METRICS_SCORE_BACKSTOP=0

# --- Alerting (optional) -------------------------------------------------
# Slack-compatible webhook fired when an aggregate metric drops below threshold
# (30-min cooldown per metric). JSON overrides for the default thresholds.
# APP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
APP_ALERT_WEBHOOK_URL=
# APP_ALERT_THRESHOLDS={"Faithfulness": 0.8}
APP_ALERT_THRESHOLDS=

# --- RAG tuning (optional; sane defaults) --------------------------------
APP_RAG_EMBEDDING_MODEL=            # unset = deterministic hash embeddings (256-dim)
APP_RAG_EMBEDDING_DIMENSION=256
APP_RAG_RETRIEVAL_K=3
