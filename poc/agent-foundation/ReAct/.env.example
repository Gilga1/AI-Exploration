# Copy this file to `.env` in THIS folder (poc/agent-foundation/ReAct/).
# Jupyter does not load .env by itself; `OpenRouterLLM.from_env()` loads it via python-dotenv.
#
# Windows: use UTF-8, no BOM; lines look like KEY=value (quotes optional).
# PowerShell alternative:
#   $env:OPENROUTER_API_KEY="sk-or-..."
#   $env:OPENROUTER_MODEL="openai/gpt-4o-mini"
#
# OpenRouter — https://openrouter.ai/docs
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TEMPERATURE=0
# OPENROUTER_MAX_TOKENS=256
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_NAME=ai-exploration-react

# Backend selector: openrouter | openai_completions
REACT_LLM_BACKEND=openrouter

# Legacy OpenAI completions (instruct models only)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo-instruct
