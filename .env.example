# Copy to .env and fill in your keys (never commit .env)

# LLM providers (used by harness/models/models.yaml)
HARNESS_SECRET_ANTHROPIC_API_KEY=sk-ant-...
HARNESS_SECRET_OPENAI_API_KEY=sk-...

# Web search via Firecrawl
HARNESS_SECRET_FIRECRAWL_API_KEY=fc-...

# Langfuse observability (OTel export)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Azure Postgres
AZURE_POSTGRES_HOST=myserver.postgres.database.azure.com
AZURE_POSTGRES_DB=sales
AZURE_POSTGRES_USER=harness_reader
HARNESS_SECRET_AZURE_POSTGRES_PASSWORD=...

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://my-search.search.windows.net
HARNESS_SECRET_AZURE_SEARCH_API_KEY=...

# Snowflake (optional — pip install -r requirements-snowflake.txt)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_USER=harness_reader
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=READER
HARNESS_SECRET_SNOWFLAKE_PASSWORD=...

# Optional connectors
HARNESS_SECRET_REDIS_PASSWORD=
REDIS_HOST=localhost

# Harness runtime overrides (optional)
# HARNESS_FORCE_STUB_MODELS=false
# HARNESS_ROUTING_USE_LLM=true
# HARNESS_TELEMETRY_CONTENT_SAMPLE_RATE=0.1
