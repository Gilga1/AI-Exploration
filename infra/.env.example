# Copy to infra/.env and adjust for your environment.

POSTGRES_DB=agentic_rag_eval
POSTGRES_USER=agentic_rag
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

OPENROUTER_API_KEY=
APP_LLM_MODEL=openai/gpt-4o-mini
APP_LLM_BASE_URL=https://openrouter.ai/api/v1
APP_LLM_PROVIDER=openrouter
APP_API_KEY=
APP_AUTH_DISABLED=true
APP_CORS_ALLOW_ORIGINS=http://localhost:5173
APP_EVAL_SAMPLING_RATE=1.0
APP_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=
