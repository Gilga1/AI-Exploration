{
  "name": "mcp-apps-exploration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental MCP Apps gallery: live maps, dashboards, sheets, and host-controlled layout.",
  "scripts": {
    "build": "vite build",
    "preview:build": "vite build --config vite.preview.config.ts",
    "preview": "vite --config vite.preview.config.ts",
    "serve": "tsx server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
